{
  "manifest_version": 3,
  "name": "Taste.io Ratings Exporter",
  "description": "Export every Taste.io movie and TV rating to a CSV file.",
  "version": "0.3.1",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Export Taste.io ratings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.taste.io/users/*/ratings*"],
      "js": ["lib/export-core.js", "lib/export-runner.js", "lib/export-ui.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
